# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://seo:seo@localhost:5433/seo_ops?schema=public

# Better Auth (generate a long random secret for production)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — owner login only (create OAuth client in Google Cloud Console)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated owner emails allowed to sign in. No public registration.
OWNER_EMAILS=you@example.com

# Frontend origin(s) allowed for CORS / trustedOrigins (dev Vite default)
WEB_ORIGIN=http://localhost:5173

# Phase 3 — GSC service account (optional for web boot; required for ingest)
# Point at a key file outside the repo. Never commit the key.
# Local example (Windows): C:\Users\Dane\.seo-console\gsc-sa.json
# Docker example: /run/secrets/gsc-sa.json
GOOGLE_APPLICATION_CREDENTIALS=

# Worker
WORKER_IDLE_MS=60000
# How often the worker may attempt GSC ingest (default 6 hours)
GSC_INGEST_INTERVAL_MS=21600000
# Run ingest shortly after worker boot (set false for quiet local restarts)
GSC_INGEST_ON_START=true
# Search Analytics request ceiling (truncate if hit; recorded in job stats)
GSC_ROW_LIMIT=5000
# Max finalized days processed per ingest run
GSC_MAX_DAYS_PER_RUN=28
# First-run / catch-up window ending at latest finalized date
GSC_INITIAL_BACKFILL_DAYS=28

# Docker Compose only — host path to mount into worker/web (never bake into image)
# GSC_SA_HOST_PATH=C:\Users\Dane\.seo-console\gsc-sa.json
# GOOGLE_APPLICATION_CREDENTIALS_DOCKER=/run/secrets/gsc-sa.json
